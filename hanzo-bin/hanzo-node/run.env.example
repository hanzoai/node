# Minimal hanzod boot config — produces a working node + HTTP API.
# Load with:
#   set -a; . run.env.example; set +a
#   unset IDENTITY_SECRET_KEY ENCRYPTION_SECRET_KEY 2>/dev/null
#   ./target/release/hanzod
#
# Tested 2026-06-01: hanzod 1.1.20 boots clean, listens on 3690/3691/3695,
# creates ~/hanzo-storage (or NODE_STORAGE_PATH below), serves HTTP API.
# Federation, zen5, and BitDelta paths are linked but opt-in via [federation]
# and [zen5] sections in hanzo.toml.

NODE_IP=0.0.0.0
NODE_PORT=3692
NODE_API_IP=0.0.0.0
NODE_API_PORT=3690
NODE_WS_PORT=3691
NODE_HTTPS_PORT=3693
NODE_API_HTTPS_PORT=3694
NODE_ZAP_IP=0.0.0.0
NODE_ZAP_PORT=3695

# Identity: leave keys UNSET (not empty) so hanzod auto-generates them on
# first boot. Setting them to empty string panics in
# string_to_signature_secret_key("").unwrap(). Delete these lines or unset
# them with `unset IDENTITY_SECRET_KEY ENCRYPTION_SECRET_KEY` after sourcing.
# IDENTITY_SECRET_KEY=
# ENCRYPTION_SECRET_KEY=
GLOBAL_IDENTITY_NAME=@@local.sep-hanzo
NO_SECRET_FILE=true

STARTING_NUM_QR_PROFILES=1
STARTING_NUM_QR_DEVICES=1
FIRST_DEVICE_NEEDS_REGISTRATION_CODE=false

NODE_STORAGE_PATH=/tmp/hanzo-storage-test
EMBEDDINGS_SERVER_URL=

RUST_LOG=info
LOG_SIMPLE=true
